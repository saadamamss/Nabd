<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- spec 07: the HTTP deny-matrix boots the REAL host in-process -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- spec 07: collections run SERIALLY — every test class owns a fresh
       Postgres container whose coordinates land in process-wide env vars;
       a parallel second class would re-point the env mid-run (latent race
       the service-level suite never tripped, the HTTP one would). -->
  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Modules\Identity\Nabd.Identity\Nabd.Identity.csproj" />
    <!-- spec 04: the suite inspects the HOST's walls (route coverage + JwtWall) -->
    <ProjectReference Include="..\..\src\Hosts\Nabd.ApiHost\Nabd.ApiHost.csproj" />
    <!-- spec 06: the suite drives the Admin room's service lane directly -->
    <ProjectReference Include="..\..\src\Modules\Admin\Nabd.Admin\Nabd.Admin.csproj" />
  </ItemGroup>

  <!-- FrameworkReference does NOT flow transitively from a ProjectReference —
       the suite speaks ClaimsPrincipal/Authorize because it inspects them. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>