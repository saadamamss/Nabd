@Nabd.ApiHost_HostAddress = http://localhost:5109

###
# P3 spec 05 — the HTTP ingest door (plan/05 §4): 200 only AFTER the DB commit.
# {token} = a real minted device token (shown once at mint/reissue time).
POST {{Nabd.ApiHost_HostAddress}}/ingest/v1
Authorization: Bearer {{deviceToken}}
Content-Type: application/json

{
  "v": 1,
  "ts": "2026-11-14T19:30:00Z",
  "seq": 9001,
  "rr": [ { "t": 22.5, "c": "temperature" }, { "t": 1, "c": "door" } ]
}

###
GET {{Nabd.ApiHost_HostAddress}}/weatherforecast/
Accept: application/json

###
