# Copy to `.env` (gitignored — 07 §7) and adjust.  dev values are local-only.
POSTGRES_USER=nabd
POSTGRES_PASSWORD=nabd_dev_only_change_me
POSTGRES_DB=nabd

RABBITMQ_USER=nabd
RABBITMQ_PASSWORD=nabd_dev_only_change_me

# EMQX dashboard: first login with EMQX-dashboard default creds (admin/public),
# then set your password — and note it here or in your password manager.
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=

NABD_DEV_FAKE_AUTH=
NABD_TOKEN_PEPPER=
NABD_DEVICE_TOKEN_PEPPER=
NABD_JWT_SECRET=

NABD_INTERNAL_SHARED_SECRET=

NABD_SMTP_HOST=sandbox.smtp.mailtrap.io
NABD_SMTP_PORT=587
NABD_SMTP_FROM=reset@nabd.local
NABD_SMTP_USER=xxxxx
NABD_SMTP_PASS=xxxxx

# Admin room — the ONE audited BYPASSRLS DB login (0011; FR-61; plan/04 §10)
NABD_ADMIN_DB_USER=nabd_admin
NABD_ADMIN_DB_PASSWORD=

# P3 spec 02 — the MQTT consumer identity (server-side subscriber)
# USER must NOT parse as a Guid (device usernames are Guids — the auth door
# dispatches on it); SECRET is random 32+ chars; BROKER is host:port.
NABD_MQTT_CONSUMER_USER=nabd-consumer
NABD_MQTT_CONSUMER_SECRET=change-me-generate-your-own-openssl-rand-hex-16
NABD_MQTT_CONSUMER_BROKER=127.0.0.1:1883